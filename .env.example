# =====================================================================
# AutoApply Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# =====================================================================

# Google Gemini API Key (Required for 4-Agent Pipeline)
# Obtain from: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Database Configuration (MySQL / XAMPP default)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
# If MySQL is not running, the application will automatically fall back to SQLite dev mode.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/autoapply?charset=utf8mb4

# JWT Authentication Secret Key
# Generate a strong key in production via: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_random_secure_secret_key_here

# App environment: development | production
# SEC-20: production strips :3000 dev CORS origins automatically.
ENV=development

# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
# SEC-16: false by default to prevent IP spoofing of rate limiter.
TRUST_PROXY=false

# Primary Gemini Model
GEMINI_MODEL=gemini-3.8-flash
